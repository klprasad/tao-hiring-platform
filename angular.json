            "tsConfig": "apps/tao-assess/tsconfig.spec.json"
          }
        }
      }
    },
    "tao-ui": {
      "projectType": "library",
      "root": "libs/tao-ui",
      "sourceRoot": "libs/tao-ui/src",
      "prefix": "tao",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
